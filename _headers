/*
  # Prevent MIME-type sniffing attacks
  X-Content-Type-Options: nosniff

  # Prevent site being embedded in iframes (clickjacking protection)
  X-Frame-Options: DENY

  # Control referrer information sent to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions policy — disable features you don't use
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # HSTS — tell browsers to always use HTTPS (1 year)
  # Only add this once HTTPS is confirmed working — it's hard to undo
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache static assets forever (they're fingerprinted via ?v= query string)
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

# Never cache the HTML shell or service worker
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
